{
  "name": "p1-app-pc",
  "productName": "Presenter",
  "version": "1.0.0",
  "description": "Presenter - lyric / slide presenter with phone remote",
  "main": "main.js",
  "author": "mranandkumar4777",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.p1.presenter",
    "productName": "Presenter",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "server.js", "public/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" }
  }
}
